<view class="page" style="height:{{viewportHeight}}px;padding-bottom:{{safeBottom}}px;">
  <view class="preview">
    <camera wx:if="{{cameraEnabled}}" class="camera" device-position="back" flash="off" resolution="medium" frame-size="medium" bindinitdone="onCameraReady" binderror="onCameraError" bindstop="onCameraStop">
      <cover-view class="selection-layer" catchtouchstart="onSelectionStart" catchtouchmove="onSelectionMove" catchtouchend="onSelectionEnd" catchtouchcancel="onSelectionCancel">
        <cover-view wx:if="{{selectionStyle}}" class="selection" style="{{selectionStyle}}"></cover-view>
        <cover-view wx:for="{{points}}" wx:key="id" wx:if="{{item.visible}}" class="sample-point" style="{{item.style}}"></cover-view>
      </cover-view>
    </camera>
    <button wx:else class="camera-start camera-button" bindtap="toggleCamera">开启相机</button>
  </view>
  <view wx:if="{{showSignals}}" class="signals-panel"><canvas type="2d" id="signals" class="signals"></canvas></view>
  <view class="readout">
    <view class="count"><text class="count-value">{{countText}}</text><text class="count-unit">圈</text></view>
    <button class="status {{complete ? '' : 'incomplete'}}" bindtap="showStatus" disabled="{{phase === 'calibrating' || phase === 'measuring'}}">{{status}}</button>
  </view>
  <view class="controls">
    <button class="small" disabled="{{!cameraReady}}" bindtap="clearSelection">圈选</button>
    <button class="main calibrate-button" disabled="{{!coreReady || (!roiSelected && phase !== 'calibrating' && phase !== 'measuring')}}" bindtap="mainAction">{{mainLabel}}</button>
    <button class="small" disabled="{{phase === 'calibrating' || phase === 'measuring'}}" bindtap="toggleSignals">信号</button>
    <button class="small help-button" disabled="{{phase === 'calibrating' || phase === 'measuring'}}" bindtap="showHelp">?</button>
  </view>
  <view wx:if="{{helpVisible}}" class="modal-backdrop" catchtouchmove="noop">
    <view class="modal"><text class="modal-title">{{helpTitle}}</text><text class="modal-body">{{helpBody || helpText}}</text><button class="main help-close" bindtap="closeHelp">知道了</button></view>
  </view>
</view>
