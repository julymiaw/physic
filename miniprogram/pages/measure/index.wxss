.page { box-sizing: border-box; display: flex; flex-direction: column; padding: 10px 12px 8px; overflow: hidden; }
.preview { position: relative; flex: 1; min-height: 80px; overflow: hidden; border-radius: 12px; background: #050907; }
.camera { width: 100%; height: 100%; }
.selection-layer { position: absolute; top: 0; left: 0; z-index: 2; background-color: rgba(0,0,0,0.01); }
.selection { position: absolute; border: 1px solid #61977f; box-sizing: border-box; }
.sample-point { position: absolute; width: 8px; height: 8px; border-radius: 4px; }
.camera-start { position: absolute; top: 42%; left: 22%; width: 56%; background: #16271e; color: #9bb3a4; }
.signals-panel { flex-shrink: 0; height: 92px; margin-top: 7px; }
.signals { width: 100%; height: 100%; }
.readout { display: flex; align-items: center; justify-content: space-between; height: 58px; flex-shrink: 0; }
.count { display: flex; align-items: baseline; padding-left: 6px; }
.count-value { font-size: 38px; font-weight: 600; color: #9bb5a5; }
.count-unit { font-size: 14px; margin-left: 10px; color: #687e70; }
.status { margin: 0; padding: 0 10px; line-height: 30px; background: #111c16; color: #779b83; font-size: 12px; }
.status.incomplete { color: #ba9067; }
.status[disabled] { background: #111c16; color: #779b83; }
.controls { display: flex; align-items: center; gap: 8px; height: 46px; flex-shrink: 0; }
.controls button { margin: 0; height: 40px; line-height: 40px; padding: 0 12px; }
.main { flex: 1; background: #254a35; color: #b2c8b9; }
.small { background: #152219; color: #89a18e; font-size: 14px; }
.help-button { width: 40px; }
button[disabled] { background: #111b14; color: #43594a; }
.modal-backdrop { position: fixed; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; z-index: 10; }
.modal { width: 82%; max-width: 360px; box-sizing: border-box; padding: 22px; border-radius: 18px; background: #142119; border: 1px solid #2a3d2f; }
.modal-title { display: block; font-size: 18px; color: #a7bfaf; margin-bottom: 18px; }
.modal-body { display: block; white-space: pre-wrap; font-size: 14px; line-height: 1.65; color: #819989; }
.modal button { margin-top: 20px; font-size: 15px; }

/* Override platform disabled-button defaults to keep the laboratory screen dark. */
.controls button.small { flex: 0 0 54px; width: 54px; min-width: 0; padding: 0; box-sizing: border-box; }
.controls button.help-button { flex-basis: 36px; width: 36px; }
.controls button.main { flex: 1 1 0; width: 0; min-width: 0; padding: 0; }
.controls button[disabled] { background: #111b14 !important; color: #43594a !important; }
button.status[disabled] { background: #111c16 !important; color: #779b83 !important; }
